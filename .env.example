# Copy this file to .env and fill it in. .env is git-ignored.

# Native PostgreSQL on macOS (step 1)
DATABASE_URL=postgres://localhost:5432/postgres

# Gemini API key from https://aistudio.google.com/apikey (needed from step 2, for embeddings)
GOOGLE_API_KEY=

# Optional: which Gemini model the researcher/auditor/synthesizer use (Phase 8).
# Defaults to gemini-3.8-flash. Flash variants each have their own free-tier daily quota,
# so this can be pointed at a sibling (e.g. gemini-3.5-flash-lite) without code changes.
#CHAT_MODEL=gemini-3.8-flash
